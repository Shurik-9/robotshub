        {"key": "cleaning_machines_count", "label": "Уборочных машин (терминал)", "unit": "шт.", "type": "int", "base": 8, "min": 2, "max": 40, "note": "Замена: автономные поломоечные машины"},
        {"key": "cleaning_area_m2", "label": "Площадь, убираемая роботизированной уборкой", "unit": "м²", "type": "number", "base": 51000, "min": 4800, "max": 300000, "note": "~60–70% площади терминала, без режимных зон"},
        {"key": "waste_containers_per_day", "label": "Вывоз мусора", "unit": "конт./сут", "type": "int", "base": 85, "min": 10, "max": 500, "note": "AMR-платформы для вывоза тележек"}
      ]
    },
    {
      "id": "staff", "name": "Персонал",
      "fields": [
        {"key": "ramp_staff", "label": "Персонал наземного обслуживания (ramp)", "unit": "чел.", "type": "int", "base": 320, "min": 50, "max": 2000},
        {"key": "terminal_staff", "label": "Персонал терминала (логистика, уборка)", "unit": "чел.", "type": "int", "base": 180, "min": 30, "max": 800},
        {"key": "ramp_salary_gross", "label": "Средняя з/п сотрудника ramp (gross)", "unit": "руб./мес.", "type": "number", "base": 100000, "min": 70000, "max": 150000},
        {"key": "cleaner_salary_gross", "label": "Средняя з/п уборщика терминала (gross)", "unit": "руб./мес.", "type": "number", "base": 65000, "min": 38000, "max": 85000, "note": "Ниже рынка, высокая текучесть"},
        {"key": "payroll_factor", "label": "Коэффициент начислений на ФОТ", "type": "number", "base": 1.302, "min": 1.302, "max": 1.302, "note": "В демо-датасете аэропорта указан 1; для консистентности методики принята ставка страховых взносов 30,2%"},
        {"key": "turnover_pct", "label": "Годовая текучесть (персонал терминала)", "unit": "%", "type": "number", "base": 35, "min": 15, "max": 60}
      ]
    },
    {
      "id": "safety", "name": "Безопасность и ограничения",
      "fields": [
        {"key": "security_zones_count", "label": "Количество режимных зон", "unit": "шт.", "type": "int", "base": 4, "min": 2, "max": 8, "note": "Airside, landside, стерильная, перрон"},
