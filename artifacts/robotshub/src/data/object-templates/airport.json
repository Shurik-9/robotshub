        {"key": "airside_certification", "label": "Сертификация оборудования для airside", "type": "enum", "base": "EASA/ИКАО", "options": ["EASA/ИКАО", "Росавиация", "Не требуется"], "note": "Серьёзный барьер: не все роботы допущены на перрон"},
        {"key": "noise_limit_dba", "label": "Ограничение по уровню шума", "unit": "дБА", "type": "number", "base": 70, "min": 55, "max": 80, "note": "Критично для ночной работы AMR"},
        {"key": "min_temp_winter_c", "label": "Температура в неотапливаемых зонах (зима)", "unit": "°C", "type": "number", "base": -25, "min": -40, "max": 0, "note": "Многие роботы не сертифицированы ниже −20 °C"}
      ]
    },
    {
      "id": "infra", "name": "Инфраструктура",
      "fields": [
        {"key": "charge_stations", "label": "Зарядных станций", "unit": "шт.", "type": "int", "base": 3, "min": 1, "max": 6, "note": "Количество зарядных мест на каждом этаже сцены"},
        {"key": "has_fids_aodb", "label": "Наличие FIDS/AODB", "type": "bool", "base": true, "note": "Источник данных для расписания роботов"},
        {"key": "has_bms", "label": "Наличие BMS", "type": "bool", "base": true, "note": "Интеграция AMR с лифтами, дверями, освещением"},
        {"key": "charging_power_kw", "label": "Доступная мощность зарядной инфраструктуры", "unit": "кВт", "type": "number", "base": 300, "min": 50, "max": 2000},
        {"key": "capex_budget_mln", "label": "Планируемый бюджет на роботизацию", "unit": "млн руб.", "type": "number", "base": 120, "min": 20, "max": 800},
        {"key": "payback_horizon_years", "label": "Горизонт расчёта окупаемости", "unit": "лет", "type": "int", "base": 7, "min": 5, "max": 15, "note": "Длиннее из-за сложности интеграции"}
      ]
