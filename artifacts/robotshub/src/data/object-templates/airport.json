        {"key": "terminal_area_m2", "label": "Суммарная площадь терминалов", "unit": "м²", "type": "number", "base": 85000, "min": 8000, "max": 500000, "note": "База для маршрутов роботов-транспортировщиков"},
        {"key": "apron_area_m2", "label": "Площадь перрона и технических зон", "unit": "м²", "type": "number", "base": 100000, "min": 10000, "max": 800000, "note": "Открытая зона: ограничения (погода, допуски)"},
        {"key": "terminals_count", "label": "Количество терминалов", "unit": "шт.", "type": "int", "base": 2, "min": 1, "max": 6, "note": "Несколько терминалов — сложная межтерминальная логистика"},
